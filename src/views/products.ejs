<h1 class="mt-5 mb-4">Products</h1>
<table class="table table-dark">
    <thead>
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Name</th>
            <th scope="col">Description</th>
            <th scope="col">Price</th>
            <th scope="col">Image</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        <!-- The loop is used to take the input and then display the table of the content -->
        <% products.forEach(product =>{ %>
            <tr>
            <th scope="row">
                <%=product.id %>
            </th>
            <td><%=product.name %></td>
            <td><%=product.desc %> </td>
            <td><%=product.price %></td>
            <td>
                <img src="<%=product.imageUrl %>" style = "max-width: : 50px"/>
            </td>
            <td>
                <a href = "/update-product/<%=product.id %>" class = "btn btn-warning">Update</a>
                <a href = "/delete-product/<%=product.id %>" class = "btn btn-danger">Delete</a>
            </td>
            </tr>
        <% }) %>     
    </tbody>
</table>
