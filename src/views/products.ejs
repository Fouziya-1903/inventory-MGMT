
<table class="table table-dark">
    <thead>
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Name</th>
            <th scope="col">Description</th>
            <th scope="col">Price</th>
            <th scope="col">Image</th>
        </tr>
    </thead>
    <tbody>
        <!-- The loop is used to take the input and then display the table of the content -->
        <% products.forEach(product =>{ %>
            <tr>
            <th><%=product.id %></th>
            <td><%=product.name %></td>
            <td><%=product.desc %> </td>
            <td ><%=product.price %></td>
            <td>
                <img src="<%=product.imageUrl %>" style = "width: : 50px;"/>
            </td>
            </tr>
        <% }) %>     
    </tbody>
</table>
