<h1 class="mt-5 mb-4 header">Update Product</h1>
<%if(errorMessage){%>
    <div class="alert alert-danger" role="alert">
        <%= errorMessage %>;
    </div>
<%}%>


<form action="/update-product" method="post" enctype="multipart/form-data">
    <input type="hidden" class="form-control" id="id" name="id" value="<%= product.id %>">

    <!-- To ensure that the old image doesn't get away if a new image is not uploaded
     -->

    <input type="hidden" name="oldImageUrl" value = "<%= product.imageUrl %>">

    <div class="mb-3">
        <label for="name" class="form-label">Product Name</label>
        <input type="text" class="form-control" id="name" name="name" value="<%= product.name %>">
    </div>
    <div class="mb-3">
        <label for="desc" class="form-label">Product Description</label>
        <textarea class="form-control" id="desc" name="desc" rows="3" required> <%= product.desc %> </textarea>
    </div>
    <div class="mb-3">
        <label for="price" class="form-label">Price</label>
        <input type="number" class="form-control" id="price" name="price" step="1" value="<%= product.price %>" >
    </div>
    <div class="mb-3">
        <label>Current Product Image:</label>
        <img src="<%= product.imageUrl %>" alt="Current Image" width = "100"; display: block; margin-bottom: 10px;">
        
        <label for="imageUrl" class="form-label">Upload New Image (Optional)</label>
        <input type="file" name="imageUrl" class="form-control" id="imageUrl">
    </div>
    <button type="submit" class="btn btn-primary">Update Product</button>
</form>